# ─── Server ───────────────────────────────────────────────────────────────
# Port the Express server listens on.
PORT=5000

# Optional: comma-separated origin(s) allowed by CORS. Use * for any origin
# during development, or a specific URL (e.g. http://localhost:5173) in prod.
CLIENT_ORIGIN=*

# Fallback "Reply-To" email used when creating campaigns if the request does
# not include a reply_to field.
REPLY_TO_EMAIL=roshnisantara7@gmail.com

# ─── Tracking ─────────────────────────────────────────────────────────────
# Public origin of this backend, embedded into the open pixel and click links
# inside every outgoing email. Email clients load these URLs, so this MUST be
# reachable from the public internet — NOT localhost (Gmail/Outlook cannot
# reach your machine).
#
# Only required for the legacy Express tracking path (TRACKING_MODE=legacy).
# When TRACKING_MODE=edge the Supabase Edge Function pixel
# (supabase/functions/campaign-tracker) is the open counter and this value is
# optional. Leave it EMPTY in edge mode so emails never carry a dead pixel —
# an expired ngrok tunnel here silently loses every open that relies on it.
#
# Production (deployed backend):
#   TRACKING_BASE_URL=https://your-public-domain.com
#
# Local development via ngrok (free tier):
#   Start ngrok on the backend port:  ngrok http 5000
#   Copy the https forwarding URL:     https://abc123.ngrok-free.app
#   TRACKING_BASE_URL=https://abc123.ngrok-free.app
#
# ⚠ IMPORTANT — ngrok FREE tier shows a "You are about to visit" browser
#   warning page (ERR_NGROK_6024) in front of every request that looks like it
#   comes from a browser. The request is intercepted by ngrok and NEVER reaches
#   this backend, so real Gmail/Outlook recipients' opens and clicks are NOT
#   recorded while that warning is shown. Requests only pass through when they
#   carry the "ngrok-skip-browser-warning: true" header (email clients and
#   browsers never send it) or the visitor clicked "Continue" once in that
#   browser. To make tracking work for real recipients either:
#     - use a paid ngrok plan and disable the browser interstitial for the
#       endpoint (Dashboard → Endpoints → browser_interstitial: disabled), or
#     - host this backend on a public URL (Render/Railway/Fly/etc.) that has no
#       interstitial, or
#     - use Cloudflare Tunnel (cloudflared tunnel --url http://localhost:5000)
#       which exposes a https://<id>.trycloudflare.com URL with NO interstitial,
#     - or just use TRACKING_MODE=edge (Supabase Edge Function is always
#       publicly reachable with no interstitial).
#
# Generated emails then embed URLs like:
#   <img src="https://YOUR_PUBLIC_DOMAIN/api/tracking/open/{trackingId}" width="1" height="1" border="0" alt="" style="display:block;border:0;width:1px;height:1px;max-width:1px;max-height:1px;" />
#   https://YOUR_PUBLIC_DOMAIN/api/tracking/click/{trackingId}?url=<destination>
#
# If this is left empty/missing the backend logs a loud warning and skips the
# legacy pixel/link rewrite (edge mode keeps working).
TRACKING_BASE_URL=

# Minimum delay (seconds) between sent_at and an open request for it to count
# as a real human open. Gmail's image proxy / Outlook prefetch request the
# tracking pixel EXACTLY ONCE within ~2 seconds of delivery and then serve the
# cached image to the human later — they never re-request it. Any grace period
# therefore means Gmail/Outlook recipients are NEVER recorded as opened.
# Keep this at 0 (the prefetch counts as the open, the industry standard).
# Click tracking is NOT affected. Default 0.
TRACKING_MIN_OPEN_DELAY=0

# ─── Edge Tracking (test-only, additive) ──────────────────────────────────
# TRACKING_MODE selects which open-tracking implementation emails carry:
#   legacy (default) — existing Express tracking ONLY (unchanged behaviour).
#   edge              — ALSO appends the Supabase Edge Function pixel
#                       (supabase/functions/campaign-tracker) to every email so
#                       both methods can be compared side by side.
TRACKING_MODE=legacy

# Base URL of your Supabase Edge Functions: https://<project-ref>.supabase.co/functions/v1
# Deploy the pixel function with:
#   supabase functions deploy campaign-tracker --no-verify-jwt
# and run  once (adds contacts.email_opened).
SUPABASE_EDGE_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1

# ─── Supabase ─────────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxx.supabase.co (Project Settings → API).
SUPABASE_URL=

# Use the service_role key for server-side access. It bypasses Row Level
# Security so the backend can insert/update the campaigns table.
# Project Settings → API → service_role (secret). Keep it private.
SUPABASE_SERVICE_ROLE_KEY=

# ─── SMTP (Nodemailer) ────────────────────────────────────────────────────
# Gmail: host=smtp.gmail.com, port=587, secure=false.
# Use an App Password (not your real password) for Gmail accounts with 2FA.
# Outlook: host=smtp.office365.com, port=587.
# Mailgun: host=smtp.mailgun.org, port=587.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_SECURE=true
# Optional display name, e.g. Acme Corp
# EMAIL_FROM_NAME=Acme Corp
# Reply-To defaults to EMAIL_FROM when unset (replies land in the sender's inbox).
EMAIL_REPLY_TO=your-email@gmail.com
# List-Unsubscribe header (mailto: works without any landing page).
# Defaults to mailto:<EMAIL_FROM>?subject=Unsubscribe when unset.
EMAIL_UNSUBSCRIBE_MAILTO=mailto:your-email@gmail.com?subject=Unsubscribe
